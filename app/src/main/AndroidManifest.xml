<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplitStay">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SplitStay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.login.LoginUIActivity"
            android:exported="true"
            android:label="@string/title_activity_login_uiactivity"
            android:theme="@style/Theme.SplitStay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.register.RegisterUIActivity"
            android:exported="true"
            android:label="RegisterUIActivity"
            android:theme="@style/Theme.SplitStay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.verifyemail.VerifyEmailActivity"
            android:exported="false"
            android:theme="@style/Theme.SplitStay"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.login.WelcomeUIActivity"
            android:exported="true"
            android:label="@string/title_activity_welcome_uiactivity"
            android:theme="@style/Theme.SplitStay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>